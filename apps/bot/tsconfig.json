{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@wystrelia/shared": ["../../packages/shared/src/index.ts"],
      "@wystrelia/shared/entities": ["../../packages/shared/src/entities/index.ts"],
      "@wystrelia/shared/domain": ["../../packages/shared/src/domain/index.ts"],
      "@wystrelia/shared/types": ["../../packages/shared/src/types/index.ts"],
      "@wystrelia/shared/enums": ["../../packages/shared/src/enums/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/shared/src/**/*"
  ]
}
